<!--
  STEP 1: In the main <activity> (the one that has MAIN + LAUNCHER today) DELETE only this intent-filter.
          Keep every other intent-filter / attribute on the activity as it is.

      <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>

  STEP 2: Paste the 4 aliases below INSIDE <application>, after the main <activity>.
          - Replace .MainActivity with the app's real main activity name.
          - Keep android:label identical to what the main activity/application uses today
            (the debug "Ozone Dual Play" build may set its own label via a placeholder, copy that logic).
          - Only the default (Lime) alias is enabled in the manifest.
-->

<activity-alias
    android:name="com.ozone.player.alias.IconLime"
    android:targetActivity=".MainActivity"
    android:enabled="true"
    android:exported="true"
    android:icon="@mipmap/ic_launcher"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:label="@string/app_name">
    <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
    </intent-filter>
</activity-alias>

<activity-alias
    android:name="com.ozone.player.alias.IconLimeWhite"
