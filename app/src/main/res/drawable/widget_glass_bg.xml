<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Layer 0: Soft outer drop shadow (#22000000, 34dp radius) -->
    <item
        android:left="2dp"
        android:top="4dp"
        android:right="2dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#22000000" />
            <corners android:radius="34dp" />
        </shape>
    </item>

    <!-- Layer 1: Dark tint scrim for readability on light wallpapers -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#3A000000" />
            <corners android:radius="32dp" />
        </shape>
    </item>

    <!-- Layer 2: Edge highlight (1.2dp gradient border, angle 315, top-left #99FFFFFF to bottom-right #08FFFFFF) -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#99FFFFFF"
                android:endColor="#08FFFFFF"
                android:type="linear" />
            <corners android:radius="32dp" />
        </shape>
    </item>

    <!-- Layer 3: Glass body (vertical gradient #38FFFFFF to #14FFFFFF, inset by border ~1.2dp) -->
    <item
        android:left="3.2dp"
        android:top="3.2dp"
        android:right="3.2dp"
        android:bottom="5.2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#38FFFFFF"
                android:endColor="#14FFFFFF"
                android:type="linear" />
            <corners android:radius="30.8dp" />
        </shape>
    </item>

    <!-- Layer 4: Thin inner top shine line (1dp, #55FFFFFF) near top edge -->
    <item
        android:left="24dp"
        android:top="4.5dp"
        android:right="24dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <size android:height="1dp" />
            <solid android:color="#55FFFFFF" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>
