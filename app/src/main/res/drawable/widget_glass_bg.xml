<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom layer: solid #33000000 with 28dp corners -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#33000000" />
            <corners android:radius="28dp" />
        </shape>
    </item>

    <!-- Top layer: diagonal gradient #38FFFFFF -> #0AFFFFFF at angle 315, 1dp stroke #4DFFFFFF, 28dp corner radius -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#38FFFFFF"
                android:endColor="#0AFFFFFF"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#4DFFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
