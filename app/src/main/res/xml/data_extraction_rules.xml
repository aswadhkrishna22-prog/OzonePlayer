<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude media cache and offline audio files -->
        <exclude
            domain="file"
            path="./exoplayer" />
        <exclude
            domain="file"
            path="./download" />
        <exclude
            domain="database"
            path="exoplayer_internal.db" />
        <!-- Exclude WebView cookies and session caches -->
        <exclude
            domain="root"
            path="app_webview" />
        <!-- Exclude BOTH preferences datastore files by construction (fail-safe against credential leakage) -->
        <exclude
            domain="file"
            path="datastore/settings.preferences_pb" />
        <exclude
            domain="file"
            path="datastore/secure_settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude media cache and offline audio files -->
        <exclude
            domain="file"
            path="./exoplayer" />
        <exclude
            domain="file"
            path="./download" />
        <exclude
            domain="database"
            path="exoplayer_internal.db" />
        <!-- Exclude WebView cookies and session caches -->
        <exclude
            domain="root"
            path="app_webview" />
        <!-- Exclude BOTH preferences datastore files from direct device transfer -->
        <exclude
            domain="file"
            path="datastore/settings.preferences_pb" />
        <exclude
            domain="file"
            path="datastore/secure_settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
