<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude media cache and offline audio files -->
        <exclude
            domain="file"
            path="./exoplayer" />
        <exclude
            domain="file"
            path="./download" />
        <exclude
            domain="database"
            path="exoplayer_internal.db" />
        <!-- Exclude sensitive session tokens and authentication credentials from cloud backup -->
        <exclude
            domain="file"
            path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude media cache and offline audio files -->
        <exclude
            domain="file"
            path="./exoplayer" />
        <exclude
            domain="file"
            path="./download" />
        <exclude
            domain="database"
            path="exoplayer_internal.db" />
        <!-- Exclude sensitive session tokens and authentication credentials from direct device transfers -->
        <exclude
            domain="file"
            path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
