<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude media cache and offline audio files -->
    <exclude
        domain="file"
        path="./exoplayer" />
    <exclude
        domain="file"
        path="./download" />
    <exclude
        domain="database"
        path="exoplayer_internal.db" />
    <!-- Exclude sensitive session tokens and authentication credentials from cloud backup -->
    <exclude
        domain="file"
        path="datastore/preferences_settings.preferences_pb" />
    <exclude
        domain="sharedpref"
        path="." />
</full-backup-content>
